# Required server-only Resend key. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional overrides. The app defaults to the branded stackorcs.com addresses
# below and creates the StackOrcs Field Notes segment automatically.
RESEND_FROM_EMAIL=StackOrcs <updates@stackorcs.com>
RESEND_REPLY_TO=hello@stackorcs.com
RESEND_NEWSLETTER_SEGMENT_ID=
CONTACT_RECIPIENT=hello@stackorcs.com

# Protects /admin and /api/admin/publish. Generate a long random value.
ADMIN_PUBLISH_KEY=
